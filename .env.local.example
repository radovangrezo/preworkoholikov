# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Project settings -> Data API -> Project URL
SUPABASE_URL=
# Project settings -> API keys -> service_role. Server-side only, full DB access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -----------------------------------------------------------------
# Prefer a restricted key (rk_...) over a secret key (sk_...). It needs write access
# to Checkout Sessions and read access to PaymentIntents.
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> your endpoint -> Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Packeta ----------------------------------------------------------------
# Client zone -> Settings -> API. The 16-character API key used by the widget.
# Public by design: it ends up in the browser.
NEXT_PUBLIC_PACKETA_API_KEY=
# Client zone -> Settings -> API. The API password used for creating packets.
# Secret: server-side only.
PACKETA_API_PASSWORD=
# Must match the sender/eshop name registered in your Packeta client zone exactly,
# otherwise Packeta rejects packet creation.
PACKETA_ESHOP_NAME=
# Home-delivery carrier IDs. Run `node scripts/packeta-carriers.mjs` to list them.
PACKETA_CARRIER_ID_HOME_SK=
PACKETA_CARRIER_ID_HOME_CZ=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Rozprávky <objednavky@preworkoholikov.sk>"
ORDER_EMAIL_FROM=
# Optional: your own address, to receive a copy of every order confirmation.
ORDER_EMAIL_BCC=

# --- Cron -------------------------------------------------------------------
# Any long random string. Protects the shipment-sync endpoint.
CRON_SECRET=

# --- Printful (merch) --------------------------------------------------------
# Printful -> Settings -> API -> private token. Note these EXPIRE; renew before they do.
PRINTFUL_ACCESS_KEY=
